# Xamvn Automation Environment Variables
# Copy this file to .env and fill in your actual credentials.
# Note: .env is ignored by git to protect your credentials.

XAMVN_USERNAME=your_username_or_email
XAMVN_PASSWORD=your_password

# Target thread ID or full URL (e.g. 307074 or https://xamvn.lifestyle/threads/307074/)
XAMVN_THREAD_ID=307074

# Default comment message (optional)
XAMVN_MESSAGE=Bài thực hành kiểm thử tự động hoá đăng bài

# Base URL (default is https://xamvn.lifestyle)
XAMVN_BASE_URL=https://xamvn.lifestyle
